# Скопируй в .env.development.local и подставь свои значения.
#
# .env.development.local в .gitignore (попадает под *.local) — там твой
# собственный проект Supabase. Файла .env.production пока нет: он появится,
# когда будет что разворачивать.
#
# Публикуемый ключ (`sb_publishable_…`) публикуем по устройству: он называет
# проект и не даёт ничего. Защищает RLS, а не он. Секретный ключ
# (`sb_secret_…`) сюда класть нельзя — это настоящая утечка, а всё с префиксом
# VITE_ попадает в клиентскую сборку открытым текстом.
#
# Старые ключи anon и service_role Supabase выводит из обращения к концу 2026.
# Роли Postgres при этом те же: публикуемый ключ приходит как `anon` без
# сессии и как `authenticated` с ней — именно на этом стоят права в
# migrations/001_schema.sql.

VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
